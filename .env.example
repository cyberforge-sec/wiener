# Copy this file to .env, then add only credentials you own. Never commit .env.
# The safe setup smoke test is replay. It uses no API key and no local model.
# Replay is not live evaluation; the competition requires Cloud or Local.

# Cloud LLM — pluggable. The security layer never changes when you do.
#
# Two adapters are implemented and tested:
#   openai_compatible (default) -> any OpenAI-shaped /chat/completions endpoint
#   anthropic                  -> native Messages API
#
# Adapter selection is configuration, not code. Credentials always come from
# the environment; nothing here is a personal endpoint or a hardcoded secret.
WIENER_CLOUD_ADAPTER=openai_compatible
# Which service the CLOUD_* settings address. Recorded in every evidence row as
# provenance; it is never used for routing or policy. It is also what the Judge
# page shows next to the model, so set it to the service you actually use
# (opencode, openai, groq, openrouter, ...). Leave it as openai_compatible and
# the UI shows the model alone, because no service name is then known.
WIENER_CLOUD_PROVIDER_LABEL=openai_compatible
# It works with direct OpenAI or any provider/gateway exposing OpenAI-compatible
# chat completions. Legacy WIENER_OPENCODE_* variables are still accepted.
# Leave the key empty unless you are intentionally configuring a live cloud run.
WIENER_CLOUD_API_KEY=
# Include the API version path required by your provider.
WIENER_CLOUD_BASE_URL=https://api.openai.com/v1
WIENER_CLOUD_MODEL=gpt-4o-mini
# The model id this route is EXPECTED to serve, when the provider reports
# something other than the requested id. Gateways that route by prefix strip
# it: a request for `gh/gpt-4o-mini-2024-07-18` is reported as
# `gpt-4o-mini-2024-07-18`. Declaring the expected id makes the check
# auditable; the harness verifies the provider's own answer against it.
# Leave EMPTY for a direct endpoint that echoes the requested id exactly.
# It must be a PINNED id (dated snapshot, trailing version, or -vN). A floating
# alias such as `big-pickle` cannot be declared into a verifiable identity.
WIENER_CLOUD_EXPECTED_MODEL=
# Namespaces this gateway is TRUSTED to strip when it reports a model id.
# Comma-separated; each entry must end with "/" and name at least one character
# before it. The trusted route prefix allows a gateway to report the canonical
# model name after stripping a configured routing namespace. It verifies the
# reported route mapping only; it does not establish that the backing model is
# pinned or immutable.
#
# A rewrite is accepted ONLY when the prefix accounts for the reported id
# exactly: request `oc/big-pickle`, prefix `oc/`, reported `big-pickle` passes;
# reported `big-pickle-v2` or `some-other-model` does not. Without an entry
# here, the same rewrite stays unverified and the identity gate blocks the run.
# This is a routing convention, not a pinning claim: `big-pickle` remains a
# floating alias and is reported as model_identity_pinned=false.
WIENER_CLOUD_MODEL_ROUTE_PREFIXES=oc/
WIENER_CLOUD_TEMPERATURE=0.0
WIENER_CLOUD_RESPONSE_FORMAT=json_object
# Optional local diagnostic file. Leave blank for normal use; never commit it.
WIENER_CLOUD_DIAG_PATH=

# Native Anthropic rung. Used only when WIENER_CLOUD_ADAPTER=anthropic; the
# ANTHROPIC_* values are ignored otherwise.
WIENER_ANTHROPIC_API_KEY=
WIENER_ANTHROPIC_BASE_URL=https://api.anthropic.com
WIENER_ANTHROPIC_MODEL=claude-sonnet-4-6
WIENER_ANTHROPIC_MAX_TOKENS=500

# Local LLM (Ollama is required for the currently implemented local provider)
# Native run: localhost is correct. Docker run: use host.docker.internal:11434.
WIENER_LOCAL_HOST=http://localhost:11434
WIENER_LOCAL_MODEL=qwen2.5:1.5b
WIENER_LOCAL_TIMEOUT_S=60
WIENER_LOCAL_MAX_TOKENS=128
# Local sampling temperature. Historical value was 0.2 (not 0): local runs are
# NOT bit-deterministic. Set 0 only if you want greedy decoding, and note that
# hosted gateways may still sample even at temperature 0.
WIENER_LOCAL_TEMPERATURE=0.2

WIENER_LOCAL_KEEP_ALIVE=5m

# Provider selection
# replay = setup smoke test / offline fallback; local = live Ollama; opencode = live cloud.
# Use an empty value for the automatic ladder: cloud -> local -> replay.
WIENER_LLM_FORCE=replay

# Runtime
WIENER_LLM_TIMEOUT_S=30
WIENER_CLOUD_COOLDOWN_S=30
WIENER_API_HOST=127.0.0.1
# Use 0.0.0.0 only on a trusted isolated network; the API has no authentication.
WIENER_API_PORT=8000
# Optional path for persisted experiment reports used by /dashboard.
# WIENER_EXPERIMENT_STORE=data/experiments
